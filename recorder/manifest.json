{
  "manifest_version": 3,
  "name": "Treadway Flow Recorder",
  "version": "0.2.0",
  "description": "Record web journeys with rich personas and assisted filling, then convert them into Treadway flows.",
  "minimum_chrome_version": "116",
  "action": { "default_title": "Open Treadway Flow Recorder" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "storage", "tabs", "webRequest", "webNavigation", "downloads", "scripting", "alarms", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/fields.js", "lib/form-runtime.js", "lib/choice-binding.js", "lib/page-fill.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
